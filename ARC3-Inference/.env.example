# Copy to .env and fill in your keys ( .env is gitignored ).

# Cerebras Inference API — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Use Cerebras instead of local vLLM (no GPU server required).
CONFIG_PATH=configs/inference.cerebras.json

# Kaggle `make kaggle-duck` uses configs/inference.gemma.json + local vLLM on GPU.
# Model weights: saltb0x/gemma-4-31b-it-qat-w4a16-pruned23808 (offline dataset snapshot).
# Cerebras is for local `make interactive` only.

# Optional overrides (defaults come from inference.cerebras.json).
# LOCAL_ANALYZER_API_KEY=
# LOCAL_ANALYZER_BASE_URL=https://api.cerebras.ai/v1
# LOCAL_ANALYZER_PROVIDER=cerebras
# LOCAL_ANALYZER_MODEL_ID=gemma-4-31b

# Kaggle submission (https://www.kaggle.com/settings → Create New API Token)
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-token

# ARC-AGI-3 live Arcade (required for official games against the competition gateway).
# ARC_API_KEY=
